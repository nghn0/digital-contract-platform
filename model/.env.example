# .env.example — Template for environment variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — only .env.example is versioned.

# ─── LLM Provider Configuration ───────────────────────────────────────

# Default provider: openrouter, anthropic, openai, gemini, grok
LLM_PROVIDER=gemini
LLM_MODEL=models/gemini-3.1-flash-lite-preview
LLM_MODEL_FALLBACKS=

# API Keys — obtain from each provider's console
# Replace placeholder values with actual keys from:
#   OpenRouter: https://openrouter.ai/keys
#   Anthropic: https://console.anthropic.com
#   OpenAI: https://platform.openai.com/api-keys
#   Google Gemini: https://ai.google.dev
#   Grok: https://console.x.ai
OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=

# ─── Runtime Configuration ───────────────────────────────────────────

# Enable/disable rate limiting to prevent quota exhaustion
ENABLE_RATE_LIMITING=true

# Safe test mode: reduces batch sizes and token limits (for development)
# Set to true to use lower API quotas for testing
SAFE_TEST_MODE=false

# Enable detailed execution tracing (produces large trace logs)
ENABLE_TRACING=false

# ─── File & Storage Configuration ────────────────────────────────────

# Maximum file size for uploads (bytes; default: 50 MB)
MAX_FILE_SIZE=52428800

# Logs directory
LOGS_DIR=logs

# Knowledge base path
KB_PATH=./knowledge-base/chroma_db

# ─── API Server Configuration ────────────────────────────────────────

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:3000

# ─── Monitoring & Observability ─────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable performance profiling (generates profile dumps)
ENABLE_PROFILING=false
