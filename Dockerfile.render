FROM python:3.10-slim

# Install Node.js 22 & build dependencies
RUN apt-get update && apt-get install -y curl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 🔥 Disable telemetry to fix ChromaDB crashes
ENV ANONYMIZED_TELEMETRY=False
ENV CHROMA_TELEMETRY_ENABLED=FALSE

# 1. Setup Python Model
COPY model/requirements.txt ./model/
RUN pip install --no-cache-dir -r model/requirements.txt
RUN python -m spacy download en_core_web_sm

# 2. Setup Node.js Backend
COPY backend/package*.json ./backend/
RUN cd backend && npm install

# 3. Copy source code
COPY model/ ./model/
COPY backend/ ./backend/
COPY proto/ ./proto/

# 4. Copy start script
COPY render_start.sh .
RUN chmod +x render_start.sh

# Render injects the PORT env var for the public API
EXPOSE 5001

# Start both servers
CMD ["./render_start.sh"]
